---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getRealAffiliateLink, getDomainByName } from '../../utils/affiliates';

const reviews = await getCollection('reviews', ({ data }) => {
  return data.language === 'es';
});

// Helper to determine category dynamically for client-side filtering
const getCategory = (name: string) => {
  const n = name.toLowerCase();
  if (['wise', 'revolut', 'n26', 'payoneer'].some(x => n.includes(x))) return 'banking';
  if (['binance', 'coinbase', 'uphold', 'robinhood'].some(x => n.includes(x))) return 'investing';
  if (['stripe', 'adyen', 'plaid'].some(x => n.includes(x))) return 'business';
  return 'payments'; // Default for neteller, skrill, payeer, webmoney, paypal, apple pay, google pay
};
---

<Layout title="Caribbean Trade | Comparación Premium de Soluciones Fintech y Cuentas" lang="es">
