---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Fintech SEO Platform | Nivel Agencia" lang="es">
	<main class="container">
		<nav class="navbar animate-fade-in" style="animation-delay: 0.1s">
			<div class="logo">
				<div class="logo-icon"></div>
				<span class="text-gradient">FinEdge</span>
			</div>
			<div class="nav-links">
				<a href="#markets">Mercados</a>
				<a href="#cards">Tarjetas</a>
				<a href="#loans">Créditos</a>
				<a href="#investments">Inversión</a>
			</div>
			<div class="lang-switch">
				<a href="/" class="lang-link">🇺🇸 ENG</a>
				<a href="#join" class="btn-primary">Abrir Cuenta</a>
			</div>
		</nav>

		<header class="hero">
			<div class="hero-content animate-fade-in" style="animation-delay: 0.3s">
				<div class="badge">🚀 El futuro del dinero</div>
				<h1 class="title">
					Multiplica tu Capital.<br/>
					<span class="text-gradient">Sin Fronteras.</span>
				</h1>
				<p class="subtitle">
					Accede a cuentas internacionales, tarjetas virtuales y plataformas de inversión globales desde un solo lugar. Transparente, seguro y con 0% de comisiones ocultas.
				</p>
				<div class="hero-actions">
					<a href="#start" class="btn-primary">Empezar a Invertir</a>
					<a href="#demo" class="btn-secondary">Ver Demo</a>
				</div>
				<div class="stats">
					<div class="stat-item">
						<span class="stat-num">$2.4B+</span>
						<span class="stat-label">Volumen Operado</span>
					</div>
					<div class="stat-item">
						<span class="stat-num">1.2M</span>
						<span class="stat-label">Usuarios Activos</span>
					</div>
					<div class="stat-item">
						<span class="stat-num">99.9%</span>
						<span class="stat-label">Uptime</span>
					</div>
				</div>
			</div>

			<div class="hero-visual animate-float animate-fade-in" style="animation-delay: 0.5s">
				<div class="glass-panel card-visual">
					<div class="card-chip"></div>
					<div class="card-network">VISA</div>
					<div class="card-balance">
						<span class="label">Balance Actual</span>
						<span class="amount">$24,592.00</span>
					</div>
					<div class="card-details">
						<span>**** **** **** 4092</span>
						<span>12/28</span>
					</div>
				</div>
				<div class="glass-panel chart-visual">
					<div class="chart-header">
						<span>Portafolio</span>
						<span style="color: var(--primary-neon)">+14.2% ↗</span>
					</div>
					<div class="chart-bars">
						<div class="bar" style="height: 40%"></div>
						<div class="bar" style="height: 70%"></div>
						<div class="bar" style="height: 50%"></div>
						<div class="bar" style="height: 90%"></div>
						<div class="bar" style="height: 60%"></div>
						<div class="bar" style="height: 100%"></div>
					</div>
				</div>
			</div>
		</header>
	</main>
</Layout>

<style>
	.navbar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 24px 0;
		margin-bottom: 60px;
	}

	.logo {
		display: flex;
		align-items: center;
		gap: 12px;
		font-size: 1.5rem;
		font-weight: 800;
	}

	.logo-icon {
		width: 32px;
		height: 32px;
		background: linear-gradient(135deg, var(--primary-neon), var(--secondary-blue));
		border-radius: 8px;
		box-shadow: 0 0 15px rgba(0, 255, 170, 0.4);
	}

	.nav-links {
		display: flex;
		gap: 32px;
	}

	.nav-links a {
		color: var(--text-muted);
		text-decoration: none;
		font-weight: 500;
		transition: color 0.3s ease;
	}

	.nav-links a:hover {
		color: var(--text-main);
	}

	.lang-switch {
		display: flex;
		align-items: center;
		gap: 20px;
	}

	.lang-link {
		color: var(--text-muted);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.9rem;
		transition: color 0.3s ease;
	}

	.lang-link:hover {
		color: var(--text-main);
	}

	.hero {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 60px;
		align-items: center;
		min-height: calc(100vh - 200px);
	}

	.badge {
		display: inline-block;
		background: rgba(0, 255, 170, 0.1);
		color: var(--primary-neon);
		padding: 8px 16px;
		border-radius: 20px;
		font-size: 0.875rem;
		font-weight: 600;
		margin-bottom: 24px;
		border: 1px solid rgba(0, 255, 170, 0.2);
	}

	.title {
		font-size: 4.5rem;
		line-height: 1.1;
		font-weight: 800;
		margin-bottom: 24px;
		letter-spacing: -0.02em;
	}

	.subtitle {
		font-size: 1.25rem;
		color: var(--text-muted);
		line-height: 1.6;
		margin-bottom: 40px;
		max-width: 90%;
	}

	.hero-actions {
		display: flex;
		gap: 16px;
		margin-bottom: 60px;
	}

	.stats {
		display: flex;
		gap: 48px;
		border-top: 1px solid var(--glass-border);
		padding-top: 32px;
	}

	.stat-item {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.stat-num {
		font-size: 2rem;
		font-weight: 700;
		color: var(--text-main);
	}

	.stat-label {
		color: var(--text-muted);
		font-size: 0.875rem;
	}

	.hero-visual {
		position: relative;
		height: 500px;
	}

	.card-visual {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%) rotate(-10deg);
		width: 380px;
		height: 240px;
		padding: 24px;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.05) 100%);
		border: 1px solid rgba(255,255,255,0.2);
		z-index: 2;
	}

	.card-chip {
		width: 45px;
		height: 35px;
		background: linear-gradient(135deg, #FFD700, #DAA520);
		border-radius: 6px;
	}

	.card-network {
		position: absolute;
		top: 24px;
		right: 24px;
		font-size: 1.5rem;
		font-weight: 800;
		font-style: italic;
	}

	.card-balance {
		display: flex;
		flex-direction: column;
	}

	.card-balance .label {
		font-size: 0.875rem;
		color: rgba(255,255,255,0.7);
	}

	.card-balance .amount {
		font-size: 2rem;
		font-weight: 700;
		letter-spacing: 1px;
	}

	.card-details {
		display: flex;
		justify-content: space-between;
		font-family: monospace;
		font-size: 1.1rem;
		color: rgba(255,255,255,0.8);
	}

	.chart-visual {
		position: absolute;
		bottom: 20px;
		right: 0px;
		width: 280px;
		padding: 20px;
		z-index: 1;
	}

	.chart-header {
		display: flex;
		justify-content: space-between;
		margin-bottom: 20px;
		font-weight: 600;
	}

	.chart-bars {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		height: 100px;
		gap: 8px;
	}

	.bar {
		width: 100%;
		background: var(--primary-neon);
		border-radius: 4px 4px 0 0;
		opacity: 0.8;
		transition: height 0.5s ease;
	}

	.bar:hover {
		opacity: 1;
		box-shadow: 0 0 10px var(--primary-neon);
	}

	@media (max-width: 968px) {
		.hero {
			grid-template-columns: 1fr;
			text-align: center;
		}

		.nav-links {
			display: none;
		}

		.subtitle {
			margin: 0 auto 40px auto;
		}

		.hero-actions {
			justify-content: center;
		}

		.stats {
			justify-content: center;
		}

		.hero-visual {
			margin-top: 60px;
		}
	}
</style>
