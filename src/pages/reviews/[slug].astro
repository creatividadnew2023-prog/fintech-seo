---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  // Obtenemos todos los archivos markdown de la carpeta src/content/reviews
  const allReviews = await getCollection('reviews');
  
  // Filtramos solo los que son en inglés (language: 'en')
  const englishReviews = allReviews.filter(review => review.data.language === 'en');

  return englishReviews.map((review) => {
    // Si el archivo es "revolut-en.md", le quitamos el "-en" para que la URL sea solo "/reviews/revolut"
    const cleanSlug = review.slug.replace('-en', '');
    
    return {
      params: { slug: cleanSlug },
      props: { review, cleanSlug },
    };
  });
}

const { review, cleanSlug } = Astro.props;
const { Content } = await review.render();
const product = review.data;
---

<Layout title={product.seoTitle} lang="en">
	<main class="container">
		<nav class="navbar">
			<a href="/" class="back-link">← Back to Home</a>
			<div class="lang-switch">
				<a href={`/es/reviews/${cleanSlug}`} class="lang-link">🇪🇸 ESP</a>
			</div>
		</nav>

		<article class="review-template">
			<header class="review-header animate-fade-in">
				<div class="product-identity">
					<div class="product-logo">{product.logo}</div>
					<div>
						<h1 class="title">{product.name} <span class="text-gradient">Review</span></h1>
						<div class="rating-badge">⭐ {product.rating} / 5.0</div>
					</div>
				</div>
				<div class="verdict-card glass-panel">
					<h3>Our Verdict</h3>
					<p>{product.verdict}</p>
					<a href={product.affiliateLink} target="_blank" rel="nofollow" class="btn-primary affiliate-btn">
						Open Account & Claim Offer
						<span class="bonus-tag">{product.bonus}</span>
					</a>
				</div>
			</header>

			<div class="review-grid animate-fade-in" style="animation-delay: 0.2s">
				<section class="glass-panel pros-cons">
					<div class="pros">
						<h3>✅ Pros</h3>
						<ul>
							{product.pros.map((pro: string) => <li>{pro}</li>)}
						</ul>
					</div>
					<div class="cons">
						<h3>❌ Cons</h3>
						<ul>
							{product.cons.map((con: string) => <li>{con}</li>)}
						</ul>
					</div>
				</section>

				<section class="glass-panel fee-structure">
					<h3>💰 Pricing & Fees</h3>
					<div class="fee-highlight">{product.fees}</div>
					<p class="text-muted">Detailed breakdown of transaction costs and limits.</p>
					<div class="skeleton-table">
						<div class="sk-row"></div>
						<div class="sk-row"></div>
						<div class="sk-row"></div>
					</div>
				</section>
			</div>

			<section class="detailed-content animate-fade-in" style="animation-delay: 0.4s">
				<h2>In-Depth Analysis</h2>
				<!-- AQUÍ ES DONDE SE RENDERIZA EL TEXTO LARGO DEL MARKDOWN (n8n + OpenAI) -->
				<div class="markdown-body">
					<Content />
				</div>
			</section>
		</article>
	</main>
</Layout>

<style>
	/* ... Estilos anteriores ... */
	.navbar { display: flex; justify-content: space-between; padding: 24px 0; margin-bottom: 40px; }
	.back-link { color: var(--primary-neon); text-decoration: none; font-weight: 600; }
	.review-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 40px; margin-bottom: 60px; }
	.product-identity { display: flex; gap: 24px; align-items: center; }
	.product-logo { width: 80px; height: 80px; background: linear-gradient(135deg, var(--bg-card), rgba(255,255,255,0.1)); border: 1px solid var(--glass-border); border-radius: 20px; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; font-weight: 800; color: var(--primary-neon); }
	.title { font-size: 3rem; margin-bottom: 8px; }
	.rating-badge { display: inline-block; background: rgba(255, 215, 0, 0.1); color: #FFD700; padding: 6px 12px; border-radius: 12px; font-weight: 600; border: 1px solid rgba(255, 215, 0, 0.2); }
	.verdict-card { padding: 24px; max-width: 400px; }
	.verdict-card h3 { margin-bottom: 12px; color: var(--primary-neon); }
	.verdict-card p { color: var(--text-muted); margin-bottom: 20px; line-height: 1.5; }
	.affiliate-btn { display: flex; flex-direction: column; width: 100%; text-align: center; padding: 16px; }
	.bonus-tag { font-size: 0.8rem; opacity: 0.9; margin-top: 4px; font-weight: 500; }
	.review-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 32px; margin-bottom: 60px; }
	.pros-cons { padding: 32px; display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
	.pros h3, .cons h3 { margin-bottom: 20px; }
	.pros ul, .cons ul { list-style: none; }
	.pros ul li, .cons ul li { margin-bottom: 12px; padding-left: 24px; position: relative; color: var(--text-muted); }
	.pros ul li::before { content: '✓'; position: absolute; left: 0; color: var(--primary-neon); }
	.cons ul li::before { content: '✕'; position: absolute; left: 0; color: #ff4757; }
	.fee-structure { padding: 32px; }
	.fee-structure h3 { margin-bottom: 16px; }
	.fee-highlight { font-size: 1.5rem; font-weight: 700; color: var(--secondary-blue); margin-bottom: 12px; }
	.skeleton-table { margin-top: 24px; display: flex; flex-direction: column; gap: 12px; }
	.sk-row { height: 24px; background: rgba(255,255,255,0.05); border-radius: 4px; }
	.detailed-content { max-width: 800px; margin: 0 auto 100px auto; }
	.detailed-content h2 { font-size: 2rem; margin-bottom: 24px; }
	
	/* Estilos para el markdown generado por n8n */
	.markdown-body { color: var(--text-muted); line-height: 1.8; font-size: 1.1rem; }
	.markdown-body p { margin-bottom: 20px; }
	.markdown-body h2 { color: var(--text-main); margin-top: 40px; margin-bottom: 20px; }
	.markdown-body strong { color: var(--text-main); }
	
	@media (max-width: 968px) {
		.review-header { flex-direction: column; }
		.review-grid { grid-template-columns: 1fr; }
		.pros-cons { grid-template-columns: 1fr; }
	}
</style>
