---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getRealAffiliateLink } from '../../utils/affiliates';

export async function getStaticPaths() {
  const allReviews = await getCollection('reviews');
  const englishReviews = allReviews.filter(review => review.data.language === 'en');

  return englishReviews.map((review) => {
    const cleanSlug = review.id.replace('-en', '');
    return {
      params: { slug: cleanSlug },
      props: { review, cleanSlug },
    };
  });
}

const { review, cleanSlug } = Astro.props;
const { Content } = await render(review);
const product = review.data;

// Resolve clean direct official links instead of example placeholders
const mainAffiliateLink = getRealAffiliateLink(product.name, product.affiliateLink);

// Convert 1-5 rating to 10-point scale
const score10 = (parseFloat(product.rating) * 2).toFixed(1);

// Sub-scores breakdown
const subScores = {
  trust: (parseFloat(product.rating) * 2 - 0.2).toFixed(1),
  service: (parseFloat(product.rating) * 2 + 0.1).toFixed(1),
  fees: (parseFloat(product.rating) * 2 - 0.4).toFixed(1),
};

// Dynamic Category
const getCategory = (name: string) => {
  const n = name.toLowerCase();
  if (['wise', 'revolut', 'n26', 'payoneer'].some(x => n.includes(x))) return 'banking';
  if (['binance', 'coinbase', 'uphold', 'robinhood'].some(x => n.includes(x))) return 'investing';
  if (['stripe', 'adyen', 'plaid'].some(x => n.includes(x))) return 'business';
  return 'payments';
};

const currentCategory = getCategory(product.name);

// Alternatives
const allReviews = await getCollection('reviews');
const alternatives = allReviews
  .filter(rev => rev.data.language === 'en' && rev.data.name !== product.name && getCategory(rev.data.name) === currentCategory)
  .slice(0, 2);
---

<Layout title={product.seoTitle} lang="en">
	<main class="container">
		<!-- Disclaimer Banner -->
		<div class="disclosure-bar animate-fade-in">
			<span class="disclosure-badge">ADVERTISER DISCLOSURE</span>
			<p>Caribbean Trade is an independent comparison platform. We may receive compensation from partner brands, but this never influences our editorial ratings.</p>
		</div>

		<nav class="navbar animate-fade-in" style="animation-delay: 0.1s">
			<a href="/" class="back-link">← Back to Comparison Grid</a>
			<div class="lang-switch">
				<a href={`/es/reviews/${cleanSlug}`} class="lang-link">🇪🇸 ESPAÑOL</a>
			</div>
		</nav>

		<!-- Header Section -->
		<header class="monito-header animate-fade-in" style="animation-delay: 0.2s">
			<div class="brand-info">
				<div class="brand-logo-large">{product.logo}</div>
				<div>
					<h1 class="main-title">{product.name} <span class="text-gradient">Review 2026</span></h1>
					
					<!-- Author Badge -->
					<div class="author-badge">
						<span class="avatar">🛡️</span>
						<span>Expert analysis verified by the <strong>Caribbean Trade Editorial Board</strong></span>
					</div>
				</div>
			</div>

			<!-- Monito Score Panel -->
			<div class="monito-score-card glass-panel">
				<div class="score-circle-wrapper">
					<div class="score-circle">
						<span class="score-num">{score10}</span>
						<span class="score-max">/10</span>
					</div>
					<span class="score-label font-accent">Monito Score</span>
				</div>
				<div class="score-sub-bars">
					<div class="sub-bar">
						<span class="bar-name">Trust &amp; Credibility</span>
						<div class="bar-track"><div class="bar-fill" style={`width: ${parseFloat(subScores.trust)*10}%`}></div></div>
						<span class="bar-val">{subScores.trust}</span>
					</div>
					<div class="sub-bar">
						<span class="bar-name">Service Quality</span>
						<div class="bar-track"><div class="bar-fill" style={`width: ${parseFloat(subScores.service)*10}%`}></div></div>
						<span class="bar-val">{subScores.service}</span>
					</div>
					<div class="sub-bar">
						<span class="bar-name">Fees &amp; Exchange Rates</span>
						<div class="bar-track"><div class="bar-fill" style={`width: ${parseFloat(subScores.fees)*10}%`}></div></div>
						<span class="bar-val">{subScores.fees}</span>
					</div>
				</div>
			</div>
		</header>

		<!-- 2-Column Review Grid -->
		<div class="review-layout animate-fade-in" style="animation-delay: 0.3s">
			
			<!-- Left Column: Detailed Content -->
			<article class="main-content">
				
				<!-- Ficha Técnica Completa (Technical Specifications Table) -->
				<section id="specs" class="specs-section glass-panel">
					<h3>📊 Technical Overview &amp; Specifications</h3>
					<div class="specs-table-wrapper">
						<table class="specs-table">
							<tbody>
								<tr>
									<td class="spec-label">Service Type</td>
									<td class="spec-value">{currentCategory.toUpperCase()} Solutions</td>
								</tr>
								<tr>
									<td class="spec-label">Standard Fee</td>
									<td class="spec-value highlighted-fee">{product.fees}</td>
								</tr>
								<tr>
									<td class="spec-label">Promo Offer</td>
									<td class="spec-value">{product.bonus || "No active welcome promotion"}</td>
								</tr>
								<tr>
									<td class="spec-label">Security &amp; Regulation</td>
									<td class="spec-value"><span class="regulated-badge">FDIC Partner / Regulated</span></td>
								</tr>
								<tr>
									<td class="spec-label">Availability</td>
									<td class="spec-value">US, UK, Europe &amp; Global account support</td>
								</tr>
							</tbody>
						</table>
					</div>
				</section>

				<!-- Target Audience Checkboxes: Who is it for? -->
				<section id="audience" class="audience-grid">
					<div class="audience-box suitable">
						<h4>✔️ Who is {product.name} best for?</h4>
						<ul>
							<li>Users looking to bypass high traditional banking transfer costs.</li>
							<li>Entities requiring fast, digital-first account management.</li>
							<li>Freelancers receiving card or bank transfers internationally.</li>
						</ul>
					</div>
					<div class="audience-box unsuitable">
						<h4>❌ Who is it NOT for?</h4>
						<ul>
							<li>Clients requiring physical branch offices for operations.</li>
							<li>Users seeking cash deposit capabilities.</li>
							<li>Entities demanding immediate checkbook issuance.</li>
						</ul>
					</div>
				</section>

				<!-- Pros & Cons -->
				<section id="pros-cons" class="pros-cons-grid">
					<div class="pros-box">
						<h3>✅ Pros (Strengths)</h3>
						<ul>
							{product.pros.map((pro: string) => <li>{pro}</li>)}
						</ul>
					</div>
					<div class="cons-box">
						<h3>✕ Cons (Weaknesses)</h3>
						<ul>
							{product.cons.map((con: string) => <li>{con}</li>)}
						</ul>
					</div>
				</section>

				<!-- Alternatives comparison table -->
				{alternatives.length > 0 && (
					<section id="alternatives" class="alternatives-card glass-panel">
						<h3>⚖️ Compare {product.name} with Alternatives</h3>
						<p class="section-desc">Not sure yet? Contrast rates and scores against similar options:</p>
						<div class="alt-table-wrapper">
							<table class="alt-table">
								<thead>
									<tr>
										<th>Provider</th>
										<th>Rating</th>
										<th>Commission Fee</th>
										<th>Action</th>
									</tr>
								</thead>
								<tbody>
									{alternatives.map(alt => (
										<tr>
											<td class="table-brand">
												<span class="table-logo">{alt.data.logo}</span>
												<strong>{alt.data.name}</strong>
											</td>
											<td><span class="stars-val">⭐ {(parseFloat(alt.data.rating) * 2).toFixed(1)}</span></td>
											<td class="fees-val">{alt.data.fees}</td>
											<td>
												<a href={getRealAffiliateLink(alt.data.name, alt.data.affiliateLink)} target="_blank" rel="nofollow" class="btn-table-cta">
													Compare ❯
												</a>
											</td>
										</tr>
									))}
								</tbody>
							</table>
						</div>
					</section>
				)}

				<!-- Detailed Editorial Analysis -->
				<section id="analysis" class="detailed-content">
					<h2>Expert Written Review &amp; Verdict</h2>
					<div class="markdown-body">
						<Content />
					</div>
				</section>

				<!-- FAQ Accordion -->
				<section id="faqs" class="faq-section glass-panel">
					<h2>Frequently Asked Questions</h2>
					<div class="faq-accordion">
						<details class="faq-item" open>
							<summary>Is {product.name} safe and regulated?</summary>
							<div class="faq-answer">
								<p>Yes. {product.name} operates under strict licensing agreements and ensures client funds are stored in tier-1 segregated banking institutions.</p>
							</div>
						</details>
						<details class="faq-item">
							<summary>What are the transaction limits?</summary>
							<div class="faq-answer">
								<p>Limits depend on the verified account tier. Typically, business users enjoy significantly higher daily and monthly limits than personal users.</p>
							</div>
						</details>
					</div>
				</section>
			</article>

			<!-- Right Column: Sidebar (Sticky CTAs) -->
			<aside class="sidebar-wrapper">
				<div class="sticky-sidebar glass-panel">
					<div class="sidebar-header-cta">
						<span class="verdict-banner">OUR VERDICT</span>
						<p class="verdict-txt">"{product.verdict}"</p>
					</div>

					<div class="cta-box">
						<div class="sidebar-logo">{product.logo}</div>
						<a href={mainAffiliateLink} target="_blank" rel="nofollow" class="btn-primary-monito">
							Open Account &amp; Claim Offer ❯
						</a>
						<span class="cta-bonus">{product.bonus}</span>
					</div>

					<nav class="sidebar-nav">
						<span class="nav-title">Page Navigation</span>
						<a href="#specs" class="nav-anchor active">Overview</a>
						<a href="#audience" class="nav-anchor">Target Audience</a>
						<a href="#pros-cons" class="nav-anchor">Pros &amp; Cons</a>
						{alternatives.length > 0 && <a href="#alternatives" class="nav-anchor">Alternatives</a>}
						<a href="#analysis" class="nav-anchor">In-Depth Review</a>
						<a href="#faqs" class="nav-anchor">FAQs</a>
					</nav>
				</div>
			</aside>

		</div>
	</main>
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const anchors = document.querySelectorAll('.nav-anchor');
		const sections = document.querySelectorAll('section[id]');

		// Scrollspy navigation highlights
		window.addEventListener('scroll', () => {
			let currentSectionId = '';
			const scrollPos = window.scrollY + 180;

			sections.forEach((sec: any) => {
				if (scrollPos >= sec.offsetTop) {
					currentSectionId = sec.getAttribute('id');
				}
			});

			anchors.forEach(a => {
				if (a.getAttribute('href') === `#${currentSectionId}`) {
					a.classList.add('active');
				} else {
					a.classList.remove('active');
				}
			});
		});
	});
</script>

<style>
	/* Disclaimer styles */
	.disclosure-bar {
		background: rgba(15, 23, 42, 0.4);
		border-bottom: 1px solid var(--glass-border);
		padding: 10px 20px;
		font-size: 0.8rem;
		color: var(--text-muted);
		display: flex;
		gap: 12px;
		align-items: center;
		margin-bottom: 20px;
		border-radius: 8px;
	}

	.disclosure-badge {
		background: rgba(255, 255, 255, 0.1);
		color: var(--text-main);
		font-weight: 700;
		padding: 3px 6px;
		border-radius: 4px;
		font-size: 0.65rem;
		letter-spacing: 0.05em;
		white-space: nowrap;
	}

	.disclosure-bar p { margin: 0; line-height: 1.3; }

	.navbar { display: flex; justify-content: space-between; padding: 20px 0; margin-bottom: 20px; }
	.back-link { color: var(--primary-neon); text-decoration: none; font-weight: 600; transition: color 0.3s; }
	.back-link:hover { color: var(--text-main); }
	.lang-link { color: var(--text-muted); text-decoration: none; font-weight: 700; font-size: 0.85rem; }

	/* Monito-style Header Grid */
	.monito-header {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 40px;
		align-items: center;
		border-bottom: 1px solid var(--glass-border);
		padding-bottom: 36px;
		margin-bottom: 40px;
	}

	.brand-info { display: flex; gap: 24px; align-items: center; }
	.brand-logo-large { width: 84px; height: 84px; background: linear-gradient(135deg, var(--bg-card), rgba(255,255,255,0.1)); border: 1px solid var(--glass-border); border-radius: 20px; display: flex; align-items: center; justify-content: center; font-size: 2.7rem; font-weight: 800; color: var(--primary-neon); box-shadow: 0 4px 15px rgba(0,0,0,0.3); }
	.main-title { font-size: 3rem; font-weight: 800; margin-bottom: 8px; letter-spacing: -0.01em; }
	
	/* Author Badge Box */
	.author-badge { display: flex; align-items: center; gap: 10px; font-size: 0.85rem; color: var(--text-muted); margin-top: 8px; background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); padding: 8px 16px; border-radius: 10px; width: fit-content; }
	.author-badge strong { color: var(--text-main); }

	/* Score Card */
	.monito-score-card {
		padding: 24px;
		display: flex;
		gap: 32px;
		align-items: center;
		border-color: rgba(255,255,255,0.08);
	}

	.score-circle-wrapper { display: flex; flex-direction: column; align-items: center; gap: 8px; }
	.score-circle { width: 72px; height: 72px; border-radius: 50%; border: 4px solid var(--primary-neon); display: flex; align-items: center; justify-content: center; background: rgba(0,255,170,0.05); }
	.score-num { font-size: 1.7rem; font-weight: 800; color: var(--primary-neon); }
	.score-max { font-size: 0.8rem; color: var(--text-muted); font-weight: 700; margin-top: 4px; }
	.score-label { font-size: 0.75rem; font-weight: 800; letter-spacing: 0.05em; color: var(--text-main); }

	.score-sub-bars { display: flex; flex-direction: column; gap: 8px; flex-grow: 1; }
	.sub-bar { display: grid; grid-template-columns: 120px 1fr 28px; gap: 12px; align-items: center; font-size: 0.8rem; }
	.bar-name { color: var(--text-muted); font-weight: 600; }
	.bar-track { height: 6px; background: rgba(255,255,255,0.05); border-radius: 3px; overflow: hidden; }
	.bar-fill { height: 100%; background: linear-gradient(90deg, var(--primary-neon), #00b377); border-radius: 3px; }
	.bar-val { font-weight: 700; color: var(--text-main); text-align: right; }

	/* 2-Column layout */
	.review-layout {
		display: grid;
		grid-template-columns: 1fr 340px;
		gap: 48px;
		align-items: start;
		margin-bottom: 80px;
	}

	.main-content { display: flex; flex-direction: column; gap: 36px; }

	/* Specs Card Style */
	.specs-section { padding: 28px; }
	.specs-section h3 { font-size: 1.25rem; font-weight: 800; margin-bottom: 20px; }
	.specs-table-wrapper { width: 100%; }
	.specs-table { width: 100%; border-collapse: collapse; }
	.specs-table td { padding: 12px 16px; border-bottom: 1px solid var(--glass-border); font-size: 0.95rem; }
	.specs-table tr:last-child td { border-bottom: none; }
	.spec-label { font-weight: 700; color: var(--text-muted); width: 40%; }
	.spec-value { color: var(--text-main); font-weight: 600; }
	.highlighted-fee { color: var(--secondary-blue) !important; font-weight: 800 !important; }
	.regulated-badge { background: rgba(0, 255, 170, 0.08); border: 1px solid rgba(0, 255, 170, 0.15); color: var(--primary-neon); padding: 3px 8px; border-radius: 6px; font-size: 0.8rem; }

	/* Suitable / Unsuitable Audience Blocks */
	.audience-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
	.audience-box { padding: 24px; border-radius: 16px; border: 1px solid var(--glass-border); }
	.suitable { background: rgba(0, 255, 170, 0.02); border-color: rgba(0, 255, 170, 0.1); }
	.unsuitable { background: rgba(255, 71, 87, 0.02); border-color: rgba(255, 71, 87, 0.1); }
	.audience-box h4 { font-size: 1.1rem; font-weight: 800; margin-bottom: 16px; }
	.suitable h4 { color: var(--primary-neon); }
	.unsuitable h4 { color: #ff4757; }
	.audience-box ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px; }
	.audience-box ul li { font-size: 0.9rem; color: var(--text-muted); line-height: 1.4; padding-left: 20px; position: relative; }
	.suitable ul li::before { content: '✓'; position: absolute; left: 0; color: var(--primary-neon); }
	.unsuitable ul li::before { content: '•'; position: absolute; left: 0; color: #ff4757; }

	/* Pros and Cons */
	.pros-cons-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
	.pros-box, .cons-box { padding: 24px; border-radius: 16px; border: 1px solid var(--glass-border); }
	.pros-box { background: rgba(0, 255, 170, 0.02); border-color: rgba(0, 255, 170, 0.12); }
	.cons-box { background: rgba(255, 71, 87, 0.02); border-color: rgba(255, 71, 87, 0.12); }
	.pros-box h3 { font-size: 1.2rem; font-weight: 800; margin-bottom: 16px; color: var(--primary-neon); }
	.cons-box h3 { font-size: 1.2rem; font-weight: 800; margin-bottom: 16px; color: #ff4757; }
	.pros-box ul, .cons-box ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 8px; }
	.pros-box ul li, .cons-box ul li { font-size: 0.95rem; color: var(--text-muted); line-height: 1.4; padding-left: 20px; position: relative; }
	.pros-box ul li::before { content: '✓'; position: absolute; left: 0; color: var(--primary-neon); font-weight: bold; }
	.cons-box ul li::before { content: '✕'; position: absolute; left: 0; color: #ff4757; font-weight: bold; }

	/* Alternatives Comparison Table */
	.alternatives-card { padding: 28px; }
	.alternatives-card h3 { font-size: 1.25rem; font-weight: 800; margin-bottom: 8px; }
	.section-desc { font-size: 0.95rem; color: var(--text-muted); margin-bottom: 20px; }
	.alt-table-wrapper { overflow-x: auto; }
	.alt-table { width: 100%; border-collapse: collapse; text-align: left; }
	.alt-table th { font-size: 0.75rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; padding: 12px 16px; border-bottom: 1px solid var(--glass-border); }
	.alt-table td { padding: 16px; border-bottom: 1px solid var(--glass-border); font-size: 0.95rem; vertical-align: middle; }
	.table-brand { display: flex; align-items: center; gap: 12px; }
	.table-logo { width: 36px; height: 36px; background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 800; color: var(--primary-neon); font-size: 1.2rem; }
	.stars-val { font-weight: 700; color: #FFD700; }
	.fees-val { color: var(--text-main); font-weight: 600; }
	
	.btn-table-cta {
		display: inline-block;
		background: rgba(255,255,255,0.05);
		border: 1px solid var(--glass-border);
		color: var(--text-main);
		text-decoration: none;
		padding: 10px 18px;
		border-radius: 8px;
		font-weight: 700;
		font-size: 0.85rem;
		transition: all 0.3s;
	}
	.btn-table-cta:hover { background: var(--primary-neon); color: #000000; border-color: var(--primary-neon); }

	/* Editorial content */
	.detailed-content h2 { font-size: 1.6rem; margin-bottom: 16px; }
	.markdown-body { color: var(--text-muted); line-height: 1.75; font-size: 1.05rem; }
	.markdown-body p { margin-bottom: 18px; }
	.markdown-body strong { color: var(--text-main); }

	/* FAQ Accordion */
	.faq-section { padding: 28px; }
	.faq-accordion { display: flex; flex-direction: column; gap: 12px; }
	.faq-item { background: rgba(255,255,255,0.02); border: 1px solid var(--glass-border); border-radius: 12px; padding: 16px 20px; transition: all 0.3s; }
	.faq-item summary { font-weight: 600; cursor: pointer; color: var(--text-main); outline: none; }
	.faq-answer { margin-top: 12px; color: var(--text-muted); font-size: 0.95rem; border-top: 1px solid var(--glass-border); padding-top: 12px; }

	/* Sidebar with Monito styling */
	.sidebar-wrapper { position: relative; height: 100%; }
	.sticky-sidebar { position: sticky; top: 24px; padding: 28px; display: flex; flex-direction: column; gap: 24px; background: linear-gradient(135deg, rgba(15, 23, 42, 0.95) 0%, rgba(5, 10, 20, 0.98) 100%); }
	
	.sidebar-header-cta { border-bottom: 1px dashed var(--glass-border); padding-bottom: 16px; }
	.verdict-banner { font-size: 0.7rem; font-weight: 800; color: var(--primary-neon); letter-spacing: 0.1em; display: block; margin-bottom: 8px; }
	.verdict-txt { color: var(--text-muted); font-size: 0.9rem; margin: 0; line-height: 1.5; font-style: italic; }

	.cta-box { display: flex; flex-direction: column; align-items: center; gap: 16px; border-bottom: 1px dashed var(--glass-border); padding-bottom: 24px; }
	.sidebar-logo { width: 56px; height: 56px; background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; font-weight: 800; color: var(--primary-neon); }
	
	/* High-Click Monito Style Button */
	.btn-primary-monito {
		background: #ff5a00; /* Monito Orange */
		color: #ffffff;
		border: none;
		border-radius: 12px;
		font-weight: 800;
		font-size: 1.05rem;
		text-align: center;
		padding: 16px 20px;
		width: 100%;
		text-decoration: none;
		transition: all 0.3s;
		box-shadow: 0 4px 15px rgba(255, 90, 0, 0.3);
	}
	.btn-primary-monito:hover { background: #e04f00; transform: translateY(-2px); box-shadow: 0 6px 20px rgba(255, 90, 0, 0.45); }
